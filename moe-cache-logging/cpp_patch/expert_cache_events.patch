+// ---------------------------------------------------------------------------
+// [expert-cache-log] Structured expert-cache event log.
+// Enabled only when MOE_EXPERT_EVENT_LOG=<path.csv> is set; otherwise every
+// call below is a single branch on a cached bool. CSV columns:
+//   ts_us,event,layer,expert,gpu,bytes,value,extra
+// events: HIT, HIT_PREFETCHED, MISS, EVICT (victim ids), OVERFLOW_LOAD,
+//         H2D_SUBMIT (value = host us spent in SetDevice),
+//         H2D_DONE   (value = GPU ms of the H2D copy, from CUDA timing events),
+//         OVERFLOW_EVICT (transient prefill expert dropped after execution)
+// ---------------------------------------------------------------------------
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <mutex>
+namespace expert_cache_log {
+struct PendingH2D {
+  cudaEvent_t start, end;
+  int layer, expert, gpu;
+  std::int64_t bytes;
+};
+struct Log {
+  FILE* f = nullptr;
+  std::mutex mu;
+  std::deque<PendingH2D> pending;
+  Log() {
+    const char* path = std::getenv("MOE_EXPERT_EVENT_LOG");
+    if (path != nullptr && path[0] != '\0') {
+      f = std::fopen(path, "w");
+      if (f) std::fprintf(f, "ts_us,event,layer,expert,gpu,bytes,value,extra\n");
+    }
+  }
+  ~Log() {
+    if (f) { Resolve(false); std::fclose(f); }  // never block at exit
+  }
+  static std::int64_t Now() {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+               std::chrono::system_clock::now().time_since_epoch()).count();
+  }
+  void WriteLocked(const char* ev, long layer, long expert, int gpu,
+                   long long bytes, double value, const char* extra) {
+    std::fprintf(f, "%lld,%s,%ld,%ld,%d,%lld,%.4f,%s\n",
+                 (long long)Now(), ev, layer, expert, gpu, bytes, value,
+                 extra ? extra : "");
+  }
+  void Write(const char* ev, long layer, long expert, int gpu,
+             long long bytes = 0, double value = 0.0,
+             const char* extra = nullptr) {
+    if (!f) return;
+    std::lock_guard<std::mutex> lock(mu);
+    WriteLocked(ev, layer, expert, gpu, bytes, value, extra);
+    Resolve(false);
+  }
+  // Emit H2D_DONE rows for copies whose end event has completed.
+  // Caller must hold mu (or be the destructor).
+  void Resolve(bool block) {
+    while (!pending.empty()) {
+      auto& p = pending.front();
+      if (block) cudaEventSynchronize(p.end);
+      else if (cudaEventQuery(p.end) != cudaSuccess) break;
+      float ms = 0.f;
+      cudaEventElapsedTime(&ms, p.start, p.end);
+      WriteLocked("H2D_DONE", p.layer, p.expert, p.gpu, p.bytes, ms, nullptr);
+      cudaEventDestroy(p.start);
+      cudaEventDestroy(p.end);
+      pending.pop_front();
+    }
+    std::fflush(f);
+  }
+  void Track(cudaEvent_t start, cudaEvent_t end, int layer, int expert,
+             int gpu, std::int64_t bytes) {
+    std::lock_guard<std::mutex> lock(mu);
+    pending.push_back(PendingH2D{start, end, layer, expert, gpu, bytes});
+  }
+};
+inline Log& Get() {
+  static Log log;
+  return log;
+}
+inline bool On() { return Get().f != nullptr; }
+}  // namespace expert_cache_log
